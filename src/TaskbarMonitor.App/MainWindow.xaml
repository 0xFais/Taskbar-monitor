<Window x:Class="TaskbarMonitor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TaskbarMonitor.App" Title="Taskbar-monitor — Fluent Desk" Icon="Assets/taskbar-monitor-logo.ico" Height="770" Width="1180" MinHeight="690" MinWidth="990" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource MainText}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10"/></WindowChrome.WindowChrome>
 <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1"><Grid><TextBlock Text="{Binding AppEditionText}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="17,0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="−" FontFamily="Segoe UI Symbol" Width="44" Click="Minimize_Click" AutomationProperties.Name="Minimize to tray"/><Button Content="□" FontFamily="Segoe UI Symbol" Width="44" Click="Maximize_Click" AutomationProperties.Name="Maximize window"/><Button Content="×" FontFamily="Segoe UI Symbol" Width="44" Click="Close_Click" AutomationProperties.Name="Close dashboard to tray"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0"><Grid Margin="15,23,15,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="4,0,0,31"><Border Width="33" Height="33" CornerRadius="10" Background="{DynamicResource NavSelectedBackground}" Margin="0,0,10,0"><Image Source="Assets/taskbar-monitor-logo.png" Width="29" Height="29" Stretch="Uniform" /></Border><StackPanel><TextBlock Text="Taskbar" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="monitor" Foreground="{DynamicResource MutedText}" FontSize="11"/></StackPanel></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="WORKSPACE" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="11,0,0,12"/><Button x:Name="OverviewNav" Click="Overview_Click" Background="{DynamicResource NavSelectedBackground}" HorizontalContentAlignment="Left" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,11,0" VerticalAlignment="Center"/><TextBlock Text="Overview"/></StackPanel></Button><Button x:Name="AppearanceNav" Click="Appearance_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,11,0" VerticalAlignment="Center"/><TextBlock Text="Customize"/></StackPanel></Button><Button x:Name="TaskbarNav" Click="Taskbar_Click" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" Margin="0,0,11,0" VerticalAlignment="Center"/><TextBlock Text="Taskbar"/></StackPanel></Button></StackPanel>
    <StackPanel Grid.Row="3" Margin="9,0"><Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,0,0,15"/><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Live monitoring" FontSize="11"/></StackPanel><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
   </Grid></Border>
   <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="28,25,28,25">
    <StackPanel x:Name="OverviewPage">
     <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your PC, at a glance." FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Live performance. Nothing in the way." Foreground="{DynamicResource MutedText}" Margin="0,5,0,0" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="☀" FontFamily="Segoe UI Symbol" Click="ToggleTheme_Click" ToolTip="Switch light / dark theme" AutomationProperties.Name="Switch light or dark theme" BorderBrush="{DynamicResource BorderBrushSoft}" Margin="0,0,8,0"/><Button Content="Customize" Click="Appearance_Click" Background="{DynamicResource NavSelectedBackground}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Grid>
     <UniformGrid Columns="4" Margin="0,0,-12,16">
      <local:MetricCard Label="PROCESSOR" Icon="&#xE950;" Value="{Binding CpuUsageText}" Suffix="%" Detail="{Binding CpuTemperatureText}" Progress="{Binding CpuUsage}" Margin="0,0,12,0"/>
      <local:MetricCard Label="GRAPHICS" Icon="&#xE7F4;" Value="{Binding GpuUsageText}" Suffix="%" Detail="{Binding GpuTemperatureText}" Progress="{Binding GpuUsage}" Margin="0,0,12,0"/>
      <local:MetricCard Label="MEMORY" Icon="&#xE964;" Value="{Binding RamUsedText}" Suffix="GB" Detail="{Binding RamDetailText}" Progress="{Binding RamUsage}" Margin="0,0,12,0"/>
      <local:MetricCard Label="NETWORK" Icon="&#xE839;" Value="{Binding DownloadText}" Detail="{Binding UploadText, StringFormat=Upload {0}}" ValueFontSize="21" ShowProgress="False" Margin="0,0,12,0"/>
     </UniformGrid>
     <Border Style="{StaticResource Surface}" Padding="20,17"><StackPanel><Grid><TextBlock Text="{Binding HistoryTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><RadioButton Content="CPU" Tag="CPU" GroupName="HistoryMetric" IsChecked="{Binding IsCpuSelected, Mode=OneWay}" Click="HistoryMetric_Click" Style="{StaticResource MetricTab}"/><RadioButton Content="GPU" Tag="GPU" GroupName="HistoryMetric" IsChecked="{Binding IsGpuSelected, Mode=OneWay}" Click="HistoryMetric_Click" Style="{StaticResource MetricTab}"/><RadioButton Content="RAM" Tag="RAM" GroupName="HistoryMetric" IsChecked="{Binding IsRamSelected, Mode=OneWay}" Click="HistoryMetric_Click" Style="{StaticResource MetricTab}"/></StackPanel></Grid><local:HistoryChart Points="{Binding SelectedHistory}" LineBrush="{DynamicResource AccentBrush}" AreaBrush="{DynamicResource NavSelectedBackground}" GridBrush="{DynamicResource BorderBrushSoft}" Height="166" Margin="0,18,0,10" AutomationProperties.Name="Usage history over the last 60 seconds"/><Grid><TextBlock Text="60 seconds ago" FontSize="10" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding HistoryValue}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource MutedText}"/><TextBlock Text="Now" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}"/></Grid></StackPanel></Border>
     <Grid Margin="1,22,1,10"><TextBlock Text="COMPACT TASKBAR PANEL" FontSize="10" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/><CheckBox IsChecked="{Binding CompactPanelEnabled}" HorizontalAlignment="Right" AutomationProperties.Name="Show compact panel on taskbar"/></Grid>
     <Border Background="#242732" CornerRadius="10" Padding="12,8"><local:TaskbarPanelView DataContext="{Binding Taskbar}" Height="42"/></Border><Grid Margin="2,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TaskbarStatus}" FontSize="11" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Taskbar appearance →" Click="Taskbar_Click" FontSize="11" Padding="8,4" Foreground="{DynamicResource AccentBrush}"/></Grid>
    </StackPanel>
    <StackPanel x:Name="AppearancePage" Visibility="Collapsed"><TextBlock Text="Make it yours." FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Appearance, monitoring, and how the app starts." Foreground="{DynamicResource MutedText}" Margin="0,5,0,23"/>
     <Border Style="{StaticResource Surface}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Color theme" FontWeight="SemiBold"/><TextBlock Text="A calm dark or bright light appearance." Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,5,20,0"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource Surface}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Refresh rate" FontWeight="SemiBold"/><TextBlock Text="A slower rate uses fewer system resources." Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,5,20,0"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding RefreshOptions}" ItemStringFormat="{}{0} ms" SelectedItem="{Binding RefreshIntervalMs}" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource Surface}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Start minimized" FontWeight="SemiBold"/><TextBlock Text="Next launch opens in the tray. The taskbar panel stays visible." Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center" AutomationProperties.Name="Start minimized to the system tray"/></Grid></Border>
     <Border Style="{StaticResource Surface}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Run at Windows sign-in" FontWeight="SemiBold"/><TextBlock Text="{Binding StartupStatus}" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,5,20,0" TextWrapping="Wrap"/><TextBlock Text="When enabled, Windows starts the app elevated at sign-in." Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,3,20,0" TextWrapping="Wrap"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" AutomationProperties.Name="Run Taskbar-monitor when I sign in to Windows"/></Grid></Border>
     <Border Style="{StaticResource Surface}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Show panel on the taskbar" FontWeight="SemiBold"/><TextBlock Text="{Binding TaskbarStatus}" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding CompactPanelEnabled}" VerticalAlignment="Center" AutomationProperties.Name="Show compact taskbar panel"/></Grid></Border>
     <Border Style="{StaticResource Surface}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Automatic CPU sensor setup" FontWeight="SemiBold"/><TextBlock Text="Off by default. Turn this on to check PawnIO and install it if needed. CPU sensors are sampled automatically when supported." Foreground="{DynamicResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,5,20,0"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding AutoSetupCpuTemperature}" VerticalAlignment="Center" AutomationProperties.Name="Automatically set up CPU sensors on launch"/></Grid></Border>
     <Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="CPU temperature sensor" FontWeight="SemiBold"/><TextBlock Text="{Binding CpuTemperatureStatus}" Foreground="{DynamicResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/><Button Content="Install sensor support" Click="InstallCpuSupport_Click" Visibility="{Binding InstallCpuDriverVisibility}" HorizontalAlignment="Left" Background="{DynamicResource NavSelectedBackground}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/><TextBlock Text="The app runs with administrator approval so CPU temperature can be read in the main process. Sensor support uses the official signed PawnIO driver." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><TextBlock Text="{Binding StorageModeText}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="1,15,0,0"/><Button Content="Exit Taskbar-monitor" Click="Quit_Click" HorizontalAlignment="Left" Foreground="{DynamicResource MutedText}" Margin="0,10,0,0"/>
    </StackPanel>
    <local:TaskbarSettingsView x:Name="TaskbarPage" Visibility="Collapsed"/>
   </Grid></ScrollViewer>
  </Grid>
 </Grid>
</Window>
