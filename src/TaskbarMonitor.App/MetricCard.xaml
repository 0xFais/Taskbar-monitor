<UserControl x:Class="TaskbarMonitor.App.MetricCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Card">
 <Border Style="{StaticResource Surface}" Padding="15" MinHeight="158"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="{Binding Label, ElementName=Card}" FontSize="10" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding Icon, ElementName=Card}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" FontSize="14"/></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,16,0,13"><TextBlock Text="{Binding Value, ElementName=Card}" FontSize="{Binding ValueFontSize, ElementName=Card}" FontWeight="SemiBold"/><TextBlock Text="{Binding Suffix, ElementName=Card}" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="5,0,0,3" VerticalAlignment="Bottom"/></StackPanel><ProgressBar x:Name="Meter" Grid.Row="2" Minimum="0" Maximum="100" Height="4" Background="{DynamicResource CardRaised}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/><TextBlock Grid.Row="3" Text="{Binding Detail, ElementName=Card}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail, ElementName=Card}"/></Grid></Border>
</UserControl>
