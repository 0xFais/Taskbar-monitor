<UserControl x:Class="TaskbarMonitor.App.TaskbarSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TaskbarMonitor.App" x:Name="Page">
 <UserControl.Resources><Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource CardRaised}"/><Setter Property="Foreground" Value="{DynamicResource MainText}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="MinWidth" Value="110"/></Style><Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style></UserControl.Resources>
 <StackPanel DataContext="{Binding Taskbar}">
  <TextBlock Text="Your taskbar, your style." FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Independent sections. Independent colors. No solid outer panel." Foreground="{DynamicResource MutedText}" Margin="0,5,0,22"/>
  <Border Style="{StaticResource Surface}" Margin="0,0,0,15"><StackPanel><Grid><TextBlock Text="LIVE TASKBAR PREVIEW" FontSize="10" Foreground="{DynamicResource MutedText}"/><Button Content="Reset taskbar" Click="Reset_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="11"/></Grid><Border Background="#242732" CornerRadius="8" Padding="12,8" Margin="0,13,0,9"><local:TaskbarPanelView Height="42"/></Border><TextBlock Text="{Binding DataContext.TaskbarStatus, ElementName=Page}" Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Style="{StaticResource Surface}" Margin="0,0,0,15"><StackPanel><TextBlock Text="Location &amp; spacing" FontSize="15" FontWeight="SemiBold"/><Grid Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Taskbar location"/><TextBlock Text="Near system tray matches the right side in your example." Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,4,20,0" TextWrapping="Wrap"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}"/></Grid>
   <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="Custom position" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CustomPositionPercent}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Custom taskbar position"/><TextBlock Grid.Column="2" Text="{Binding PositionLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="11"/></Grid>
   <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="Fine horizontal adjustment" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="-400" Maximum="400" Value="{Binding HorizontalOffset}" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Taskbar horizontal offset"/><TextBlock Grid.Column="2" Text="{Binding OffsetLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="Space between sections" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="24" Value="{Binding Gap}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Space between taskbar sections"/><TextBlock Grid.Column="2" Text="{Binding GapLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/></Grid>
  </StackPanel></Border>
  <Border Style="{StaticResource Surface}" Margin="0,0,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Apply a style to all sections" FontWeight="SemiBold"/><TextBlock Text="You can then customize each section independently." Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,4,20,0"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/></Grid></Border>
  <Border Style="{StaticResource Surface}"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Customize a section" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Sections}" DisplayMemberPath="Id" SelectedItem="{Binding SelectedSection}"/><StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"><Button Content="←" Click="MoveLeft_Click" ToolTip="Move this section earlier"/><Button Content="→" Click="MoveRight_Click" ToolTip="Move this section later"/></StackPanel></Grid>
   <StackPanel DataContext="{Binding SelectedSection}" Margin="0,18,0,0">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><CheckBox Content="Visible" IsChecked="{Binding Enabled}" Margin="0,0,22,0"/><CheckBox Content="Show label" IsChecked="{Binding ShowLabel}" Margin="0,0,22,0"/><CheckBox Content="Second line" IsChecked="{Binding ShowDetail}"/></StackPanel>
    <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="Section style" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Taskbar.Styles, ElementName=Page}" SelectedItem="{Binding Style}"/><TextBlock Grid.Column="2" Text="Font" Margin="20,0,0,0" VerticalAlignment="Center"/><ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.Taskbar.Fonts, ElementName=Page}" SelectedItem="{Binding FontName}"/></Grid>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Text color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}"/><Button Grid.Column="2" Content="Choose" Tag="TextColor" Click="ChooseColor_Click" Margin="8,0,0,0"/></Grid>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Accent / outline color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding AccentColor, UpdateSourceTrigger=LostFocus}"/><Button Grid.Column="2" Content="Choose" Tag="AccentColor" Click="ChooseColor_Click" Margin="8,0,0,0"/></Grid>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Section fill color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding BackgroundColor, UpdateSourceTrigger=LostFocus}"/><Button Grid.Column="2" Content="Choose" Tag="BackgroundColor" Click="ChooseColor_Click" Margin="8,0,0,0"/></Grid><TextBlock Text="{Binding ColorError}" Foreground="{DynamicResource OrangeBrush}" FontSize="11"/>
    <Grid Margin="0,4,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Fill opacity" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency=".05" IsSnapToTickEnabled="True" Value="{Binding FillOpacity}" AutomationProperties.Name="Selected section fill opacity"/><TextBlock Grid.Column="2" Text="{Binding FillLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/></Grid><TextBlock Text="Fill color and opacity apply to Soft pills and Solid tiles. Colored text has no visible backing." Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap"/>
    <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Text size" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="9" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" AutomationProperties.Name="Selected section text size"/><TextBlock Grid.Column="2" Text="{Binding FontSizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Section width" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="64" Maximum="190" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Width}" AutomationProperties.Name="Selected section width"/><TextBlock Grid.Column="2" Text="{Binding WidthLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/></Grid>
   </StackPanel>
  </StackPanel></Border>
  <TextBlock Text="Changes save automatically and apply to the taskbar only. The dashboard keeps its own theme." Foreground="{DynamicResource MutedText}" FontSize="11" Margin="1,15,0,3" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
